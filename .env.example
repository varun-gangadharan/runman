# Copy to .env.local and fill in. .env.local is gitignored.
# There are deliberately no defaults in code: a missing value fails loudly.

# Strava API app (https://www.strava.com/settings/api)
# The client ID is public; the secret must NEVER appear in committed source,
# in a browser bundle, or in this file with a real value.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Supabase project (Project Settings -> API)
# The service-role key bypasses RLS. Server-side only, never in the web app.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Random 32+ byte secret for signing session cookies and OAuth state.
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Public origin of the deployment, used to build the OAuth redirect URI.
APP_URL=http://localhost:3000
